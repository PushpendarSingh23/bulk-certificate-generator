# Application Settings
APP_NAME="Bulk Certificate Generator API"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=false
LOG_LEVEL="INFO"

# Database Configuration (SQLite default; PostgreSQL compatible)
# For SQLite:
DATABASE_URL="sqlite:///./storage/certificates.db"
# For PostgreSQL example:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/cert_db"

# Storage Settings
STORAGE_DIR="./storage/certificates"

# Job Batch and Pagination Limits
MAX_BATCH_SIZE=500
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
